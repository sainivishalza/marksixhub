<%- include('partials/head') %>
<h1>Create a free account</h1>
<p>Save your favourite number sets and keep your preferred currency.</p>
<% if (error) { %><p class="notice err" role="alert"><%= error %></p><% } %>
<form method="post" action="/register" class="card form">
  <%- csrfField() %>
  <label>Email <input type="email" name="email" required autocomplete="email" maxlength="190"></label>
  <label>Password (10+ characters) <input type="password" name="password" required minlength="10" maxlength="200" autocomplete="new-password"></label>
  <button class="btn" type="submit">Sign up</button>
</form>
<p>Already registered? <a href="/login">Log in</a>.</p>
<%- include('partials/foot') %>
