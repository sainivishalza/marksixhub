<%- include('partials/head') %>
<h1>Log in</h1>
<% if (error) { %><p class="notice err" role="alert"><%= error %></p><% } %>
<form method="post" action="/login" class="card form">
  <%- csrfField() %>
  <input type="hidden" name="next" value="<%= next %>">
  <label>Email <input type="email" name="email" required autocomplete="email" maxlength="190"></label>
  <label>Password <input type="password" name="password" required autocomplete="current-password" maxlength="200"></label>
  <button class="btn" type="submit">Log in</button>
</form>
<p>New here? <a href="/register">Create a free account</a>.</p>
<%- include('partials/foot') %>
