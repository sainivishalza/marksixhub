# Copy to .env for local dev (never commit .env). On Hostinger, set these in the Node.js app's Environment variables.
NODE_ENV=production
BASE_URL=https://marksixhub.com
# 32+ random characters, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# MySQL database created in hPanel > Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# First admin account, created on first start if no admin exists. Remove ADMIN_PASSWORD after first login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Email for password reset links. Any SMTP service works, e.g. the Hostinger mailbox: smtp.hostinger.com, port 465.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Shown as the sender, e.g. Mark Six Hub <no-reply@marksixhub.com>
MAIL_FROM=

# Shown in the footer. Phone is optional and hidden when empty.
CONTACT_EMAIL=info@marksixhub.com
CONTACT_PHONE=

# Optional visitor stats: your site name in Plausible (plausible.io). Leave empty for none.
PLAUSIBLE_DOMAIN=

# Optional: email me when a new order arrives (needs the SMTP settings above).
ORDER_ALERT_EMAIL=

# Google Analytics 4 measurement id (looks like G-ABC123XYZ). Empty = no Google Analytics.
GA_MEASUREMENT_ID=
# Search Console: the content value of the google-site-verification meta tag. Empty = none.
GOOGLE_SITE_VERIFICATION=

# Where the daily health email goes (falls back to ORDER_ALERT_EMAIL, then ADMIN_EMAIL). Needs the SMTP settings above.
HEALTH_ALERT_EMAIL=

# Who runs the site (shown on the About page and footer when set), e.g. a person or company name and a postal address.
OPERATOR_NAME=
OPERATOR_ADDRESS=

# Optional: where the admin "Fetch the latest result" button reads from. One fixed https address you trust (nobody can type another).
# It may return JSON {"drawNo":"26/104","date":"2026-09-26","numbers":[1,2,3,4,5,6],"extra":7,"turnover":14675740,"prizes":[{"division":1,"winners":0,"prize":8000000}]}
# or a page whose text contains the result. Nothing is saved or published by the button: the admin checks the filled form first.
RESULT_SOURCE_URL=

# Security. How many reverse proxies sit in front of the app (Hostinger shows the chain in Admin > Health check). With this set, the visitor
# address is taken from the right of X-Forwarded-For, so a visitor cannot forge it to dodge the rate limits. Leave empty until you have checked.
TRUSTED_PROXY_HOPS=
# Set to 1 to require two-step login for every staff account before it can open the admin area (members can set it up under Account > Settings).
REQUIRE_STAFF_2FA=
