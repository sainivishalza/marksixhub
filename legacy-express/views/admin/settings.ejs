<%- include('../partials/head') %>
<%- include('_nav') %>
<h1>Site settings</h1>
<form method="post" action="/admin/settings" class="card form">
  <%- csrfField() %>
  <label>Site name <input name="site_name" value="<%= site.site_name %>" maxlength="60" required></label>
  <label>Home page description (search engines show this, keep it under 160 characters) <textarea name="site_description" maxlength="300" rows="3"><%= site.site_description %></textarea></label>
  <label>Announcement banner (leave empty to hide) <input name="announcement" value="<%= site.announcement %>" maxlength="300"></label>
  <button class="btn" type="submit">Save settings</button>
</form>
<%- include('../partials/foot') %>
